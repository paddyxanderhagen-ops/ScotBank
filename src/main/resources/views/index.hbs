<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>Scotbank - Home</title>
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"
              integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    </head>
    <body class="min-vh-100 vh-100">
        <header class="container row py-3 m-auto" style="height:10%;">
            <div class="row">
                <h1 class="m-0 col-9">Scotbank</h1>
                <a href="/" class="col-3 nav-link align-self-center fs-5">Log Out</a>
            </div>
        </header>

        <main class="container row m-auto">
            <div class="bg-light border mb-3">
                <h4 class="py-3 m-0 ps-2">Hello, {{name}}</h4>

            <div class="col-6">
                <a href="/analytics" class="action-card">
                    <div class="fw-bold">Investment Analytics</div>
                    <div class="small text-muted">
                        Portfolio value and performance
                    </div>
                </a>
            </div>

            <div class="col-6">
                <a href="/managecash" onclick="openCloseForm()" class="action-card">
                    <div class="fw-bold">Manage Cash</div>
                    <div class="small text-muted">
                        Deposit or withdraw funds
                    </div>
                </a>
            </div>

            <div class="col-6">
                <a href="/contact" class="action-card">
                    <div class="fw-bold">Contact</div>
                    <div class="small text-muted">
                        Customer support
                    </div>
                </a>
            </div>

        </div>

    </section>

    <section class="card-soft">

        <div class="d-flex justify-content-between align-items-center mb-2">

            <h5 class="fw-bold m-0">Recent Transactions</h5>

            <a href="/debug/transactions" class="showall">Show all</a>

        </div>

        {{#if transactions}}

            {{#each transactions}}

                <div class="transaction d-flex justify-content-between">

                    <div>

                        <div class="fw-semibold">{{type}}</div>

                        <div class="small text-muted">
                            {{ticker}} • {{timestamp}}
                        </div>

                    </div>

                    <div class="amount">
                        £{{totalCashAmount}}
                    </div>

                </div>

            {{/each}}

        {{else}}

            <p class="text-muted mb-0">No transactions yet</p>

        {{/if}}

    </section>

</main>


<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
<script src="../assets/CashAccount.js"></script>

<script>

    function toggleMenu(){
        document.getElementById("menu").classList.toggle("open");
    }

</script>

</body>
</html>