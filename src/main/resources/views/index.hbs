<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>Scotbank - Home</title>
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"
              integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    </head>
    <body class="container min-vh-100 vh-100">
        <header class="py-3" style="height:10%;">
            <h1 class="m-0">Scotbank</h1>
        </header>

        <main style="height:80%;">
            <h2 class="py-3 m-0">Hello, {{name}}</h2>

            <h3 class="py-3 m-0">Balance: £{{balance}}</h3>

            <div class="row py-3 m-auto">
                <button onclick="openCloseForm()" class="btn btn-primary col">Deposit/Withdraw</button>
            </div>
            <h2 class="py-3 m-0">Transaction History</h2>


            <form id="transactionForm" class="container bg-light border d-none position-absolute top-50 start-50 translate-middle h-75" style="width: 95%;">
                <div class="row py-3">
                    <h2 class="col m-0 mt-3">Transaction</h2>
                    <button onclick="openCloseForm()" class="col-3 btn btn-primary m-3" type="button">Close X</button>
                </div>
                <div class="row py-3 m-auto">
                    <label for="amount" class="form-label">Amount:</label>
                    <input type="text" name="amount" inputmode="numeric" step="0.01" autocomplete="off" id="amount" class="row form-control form-control-lg m-auto">
                </div>
                <div class="row py-3 m-auto">
                    <label for="transaction-type" class="form-label">Transaction type:</label>
                    <select name="transactionType" id="transaction-type" class="row form-control form-control-lg form-select m-auto">
                        <option value="deposit">Deposit</option>
                        <option value="withdraw">Withdraw</option>
                    </select>
                </div>
                <button type="submit" class="btn btn-primary btn-lg row position-absolute bottom-0 start-50 translate-middle m-auto w-75">Submit</button>
            </form>
        </main>

        <footer class="py-3" style="height:10%;">
            <div class="row">
                <div class="col text-center m-0">
                    <p>Home Placeholder</p>
                </div>
                <div class="col text-center m-0">
                    <p>Stocks Placeholder</p>
                </div>
            </div>
        </footer>
        <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.11.8/dist/umd/popper.min.js"
                integrity="sha384-I7E8VVD/ismYTF4hNIPjVp/Zjvgyol6VFvRkX/vR+Vc4jQkC+hVqc2pM8ODewa9r"
                crossorigin="anonymous"></script>
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
                integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
                crossorigin="anonymous"></script>
        <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
        <script src="/assets/CashAccount.js"></script>
    </body>
</html>