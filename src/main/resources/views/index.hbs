<!doctype html>
<html lang="en">
<head>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>Scotbank Dashboard</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css">

    <link rel="stylesheet" href="/assets/styles.css">

</head>

<body>

{{>partials/navbar.hbs}}

<main class="container py-3">

    <section class="hero mb-4">

        <div>Welcome back</div>

        <h2 class="fw-bold">{{name}}</h2>

        <div class="mt-3">Cash Balance</div>

        <div class="balance">£{{balance}}</div>

        <button onclick="openCloseForm()"
                class="btn btn-light w-100 mt-3 fw-bold ">
            Deposit / Withdraw
        </button>

    </section>

    <section class="mb-4">

        <h5 class="fw-bold mb-3">Quick Actions</h5>

        <div class="row g-3">

            <div class="col-6">
                <a href="/taxreport" class="action-card">
                    <div class="fw-bold">Tax Report</div>
                    <div class="small text-muted">
                        View realised gains and tax summary
                    </div>
                </a>
            </div>

            <div class="col-6">
                <a href="/analytics" class="action-card">
                    <div class="fw-bold">Investment Analytics</div>
                    <div class="small text-muted">
                        Portfolio value and performance
                    </div>
                </a>
            </div>

            <div class="col-6">
                <a href="/managecash" onclick="openCloseForm()" class="action-card">
                    <div class="fw-bold">Manage Cash</div>
                    <div class="small text-muted">
                        Deposit or withdraw funds
                    </div>
                </a>
            </div>

            <div class="col-6">
                <a href="/contact" class="action-card">
                    <div class="fw-bold">Contact</div>
                    <div class="small text-muted">
                        Customer support
                    </div>
                </a>
            </div>

        </div>

    </section>

    <section class="card-soft">

        <div class="d-flex justify-content-between align-items-center mb-2">

            <h5 class="fw-bold m-0">Recent Transactions</h5>

            <a href="/transactions/ViewAll?id={{id}}" class="showall">Show all</a>

        </div>

        {{#if transactions}}

            {{#each transactions}}

                <div class="transaction d-flex justify-content-between">

                    <div>

                        <div class="fw-semibold">{{type}}</div>

                        <div class="small text-muted">
                            {{ticker}} • {{timestamp}}
                        </div>

                    </div>

                    <div class="amount">
                        £{{totalCashAmount}}
                    </div>

                </div>

            {{/each}}

        {{else}}

            <p class="text-muted mb-0">No transactions yet</p>

        {{/if}}

    </section>

</main>


<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
<script src="../assets/CashAccount.js"></script>

<script>

    function toggleMenu(){
        document.getElementById("menu").classList.toggle("open");
    }

</script>

</body>
</html>