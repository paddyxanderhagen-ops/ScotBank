<!doctype html>
<html lang="en">
<head>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>Scotbank Dashboard</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css">

    <link rel="stylesheet" href="/assets/styles.css">

</head>

<body>

{{>partials/navbar.hbs}}

<main class="container py-3">

    <section class="hero mb-4">

        <div>Welcome back</div>

        <h2 class="fw-bold">{{name}}</h2>

        <div class="mt-3">Cash Balance</div>

        <div class="balance">£{{balance}}</div>
    </section>

    <section class="mb-4">

        <h5 class="fw-bold mb-3">Manage Cash</h5>

        <div class="row g-3">
            <div class="col-12">
                <form class="bg-white border rounded-4 p-4" id="transaction-form">
                    <div class="row py-3">
                        <h2 class="col m-0">Transaction</h2>
                    </div>
                    <div class="row py-3 m-auto">
                        <label for="amount" class="form-label">Amount:</label>
                        <input type="text" name="amount" inputmode="numeric" step="0.01" autocomplete="off" id="amount" placeholder="00.00" class="row form-control form-control-lg m-auto">
                        <div id="error"></div>
                    </div>
                    <div class="row py-3 m-auto">
                        <label for="transaction-type" class="form-label">Transaction type:</label>
                        <select name="transactionType" id="transaction-type" class="row form-control form-control-lg form-select m-auto">
                            <option value="deposit">Deposit</option>
                            <option value="withdraw">Withdraw</option>
                        </select>
                    </div>
                    <div class="row py-3 m-auto">
                        <button type="submit" class="btn btn-primary btn-lg m-auto">Submit</button>
                    </div>
                </form>
            </div>
        </div>
    </section>
</main>


<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script src="../assets/CashAccount.js"></script>

</body>
</html>