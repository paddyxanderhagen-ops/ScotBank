<!doctype html>
<html lang="en">

<head>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>Scotbank</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css">

    <link rel="stylesheet" href="/assets/styles.css">

    <style>

        .hero-wrapper{
            min-height:100vh;
            display:flex;
            align-items:center;
        }

        .hero-card{
            background:white;
            border:1px solid var(--border);
            border-radius:24px;
            padding:40px;
            max-width:700px;
            margin:auto;
            box-shadow:0 30px 60px rgba(0,0,0,0.08);
            text-align:center;
        }

        .hero-title{
            font-weight:900;
            color:var(--blue);
            letter-spacing:-0.03em;
        }

        .hero-subtitle{
            color:#5b6b82;
            margin-top:10px;
        }

        .feature{
            background:#f8fbff;
            border:1px solid var(--border);
            border-radius:16px;
            padding:16px;
            font-size:14px;
        }

        .login-btn{
            background:var(--blue);
            border:none;
            border-radius:12px;
            padding:14px;
            font-weight:700;
            color:white;
        }

        .login-btn:hover{
            background:var(--blue-dark);
            color:white;
        }

    </style>

</head>

<body>

<div class="hero-wrapper container">

    <div class="hero-card">

        <h1 class="hero-title">
            Scotbank
        </h1>

        <p class="hero-subtitle">
            Modern investment banking dashboard for managing your portfolio and cash accounts.
        </p>

        <div class="row mt-4 g-3">

            <div class="col-12 col-md-4">
                <div class="feature">
                    <strong>Track investments</strong><br>
                    Monitor portfolio value and holdings
                </div>
            </div>

            <div class="col-12 col-md-4">
                <div class="feature">
                    <strong>Manage cash</strong><br>
                    Deposit or withdraw funds instantly
                </div>
            </div>

            <div class="col-12 col-md-4">
                <div class="feature">
                    <strong>Investment analytics</strong><br>
                    View performance and tax reports
                </div>
            </div>

        </div>

        <a href="/login" class="btn login-btn w-100 mt-4">
            Log in
        </a>

    </div>

</div>

</body>
</html>
