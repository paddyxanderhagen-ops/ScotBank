<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Contact</title>
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="/assets/styles.css">
    <style>
        .page-wrapper {
            max-width: 700px;
            margin: auto;
            padding-top: 40px;
            padding-bottom: 60px;
        }
        .contact-hero {
            text-align: center;
            margin-bottom: 40px;
        }
        .contact-hero h2 {
            font-weight: 800;
            font-size: 32px;
        }
        .contact-hero p {
            color: #6c7b93;
            font-size: 16px;
            margin-top: 8px;
        }
        .contact-card {
            display: flex;
            align-items: center;
            gap: 16px;
            padding: 20px 24px;
            border-radius: 16px;
            background: white;
            border: 1px solid var(--border);
            margin-bottom: 16px;
        }
        .contact-label {
            font-size: 12px;
            color: #6c7b93;
            margin-bottom: 2px;
        }
        .contact-value {
            font-weight: 700;
            font-size: 16px;
        }
        .contact-sub {
            font-size: 13px;
            color: #6c7b93;
            margin-top: 2px;
        }
        .section-label {
            font-size: 12px;
            font-weight: 700;
            color: #6c7b93;
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 12px;
            margin-top: 28px;
        }
    </style>
</head>

<body>

{{>partials/navbar.hbs}}

<main class="page-wrapper px-3">

    <div class="contact-hero">
        <h2>Contact Us</h2>
        <p>We're here to help. Reach out through any channel below.</p>
    </div>

    <div class="section-label">Get in touch</div>

    <div class="contact-card">
        <div>
            <div class="contact-label">Phone</div>
            <div class="contact-value">+44 141 248 2000</div>
            <div class="contact-sub">Available 24 hrs</div>
        </div>
    </div>

    <div class="contact-card">
        <div>
            <div class="contact-label">Email</div>
            <div class="contact-value">support@scotbank.co.uk</div>
            <div class="contact-sub">We respond within 24 hours</div>
        </div>
    </div>

    <div class="contact-card">
        <div>
            <div class="contact-label">Branch</div>
            <div class="contact-value">University of Strathclyde</div>
            <div class="contact-sub">16 Richmond St, Glasgow G1 1XQ</div>
        </div>
    </div>

</main>

</body>
</html>