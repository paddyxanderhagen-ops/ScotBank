<!doctype html>
<html lang="en">

<head>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>Portfolio</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css">

    <link rel="stylesheet" href="/assets/styles.css">

    <style>

        .page-wrapper{
            max-width:900px;
            margin:auto;
            padding-top:20px;
        }

        .position-row{
            display:flex;
            justify-content:space-between;
            align-items:center;
            padding:16px;
            border-bottom:1px solid var(--border);
        }
        .position-header{
            display:flex;
            justify-content:space-between;
            align-items:center;
            padding:16px;
            border-bottom:1px solid var(--border);
        }

        .position-row:hover{
            background:#f8fbff;
            cursor:pointer;
        }

        .ticker{
            font-weight:700;
            font-size:18px;
        }

        .shares{
            color:#6c7b93;
            font-size:14px;
        }

        .value{
            font-weight:700;
        }
        .table-header{
            font-weight:700;
            font-size:18px;
        }
        .login-btn{
            align-items:left;
            maximum-width:200px;
            background:var(--blue);
            border:none;
            border-radius:12px;
            padding:14px;
            font-weight:700;
            color:white;
        }
        .login-btn:hover{
            align-items:center;
            background:var(--blue-dark);
            color: white;
        }
        .button-wrapper{
            display:inline-block;
            padding:10px;
            max-width:400px;
            margin:auto;
        }
    </style>

</head>

<body>

{{>partials/navbar.hbs}}
<div class="button-wrapper">
    <form class="login-card" action="/instruments" method="get">
        <button
                type="submit"
                class="btn login-btn w-100">

            Return
        </button>

</div>
<main class="page-wrapper">

    <h3 class="mb-4">Instrument not found</h3>

</main>

</body>
</html>
