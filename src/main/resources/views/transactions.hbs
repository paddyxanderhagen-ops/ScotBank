<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Transactions</title>
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="/assets/styles.css">
    <style>
        .page-wrapper {
            max-width: 900px;
            margin: auto;
            padding-top: 20px;
        }
        .position-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 16px;
            border-bottom: 1px solid var(--border);
        }
        .position-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 16px;
            border-bottom: 1px solid var(--border);
        }
        .position-row:hover {
            background: #f8fbff;
        }
        .ticker {
            font-weight: 700;
            font-size: 16px;
        }
        .meta {
            color: #6c7b93;
            font-size: 14px;
        }
        .value {
            font-weight: 700;
        }
        .table-header {
            font-weight: 700;
            font-size: 15px;
            color: #6c7b93;
        }
    </style>
</head>

<body>

{{>partials/navbar.hbs}}

<main class="page-wrapper">

    <h3 class="mb-4">Transaction History</h3>

    <div class="card-soft">

        <div class="position-header">
            <div class="table-header" style="flex:2">Type</div>
            <div class="table-header" style="flex:2">Ticker</div>
            <div class="table-header" style="flex:2">Date</div>
            <div class="table-header" style="flex:1;text-align:right">Amount</div>
        </div>

        {{#if transactions}}

            {{#each transactions}}

                <div class="position-row">

                    <div style="flex:2">
                        <span class="meta">{{type}}</span>
                    </div>

                    <div style="flex:2">
                        <div class="ticker">{{#if ticker}}{{ticker}}{{else}}—{{/if}}</div>
                    </div>

                    <div style="flex:2">
                        <div class="meta">{{timestamp}}</div>
                    </div>

                    <div style="flex:1;text-align:right">
                        <div class="value">£{{totalCashAmount}}</div>
                    </div>

                </div>

            {{/each}}

        {{else}}

            <p class="text-muted p-3">No transactions found</p>

        {{/if}}

    </div>

</main>

</body>
</html>