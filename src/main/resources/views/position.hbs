<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Position</title>
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="/assets/styles.css">
    <style>
        .page-wrapper {
            max-width: 700px;
            margin: auto;
            padding-top: 30px;
            padding-bottom: 60px;
        }
        .stat-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 16px;
            margin-bottom: 16px;
        }
        .stat-grid.single-row {
            margin-bottom: 0;
        }
        .stat-card {
            background: white;
            border: 1px solid var(--border);
            border-radius: 16px;
            padding: 20px 24px;
        }
        .stat-card.full {
            grid-column: span 2;
        }
        .stat-label {
            font-size: 12px;
            color: #6c7b93;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-bottom: 6px;
        }
        .stat-value {
            font-size: 22px;
            font-weight: 800;
        }
        .positive { color: #1e7e34; }
        .negative { color: #c0392b; }
        .back-link {
            display: inline-block;
            margin-bottom: 20px;
            color: #6c7b93;
            font-size: 14px;
            text-decoration: none;
        }
        .back-link:hover { color: #1a73e8; }
        .section-divider {
            height: 8px;
        }
    </style>
</head>

<body>

{{>partials/navbar.hbs}}

<main class="page-wrapper px-3">

    {{#with position}}

        <h3 class="fw-bold mb-4">{{ticker}}</h3>

        <div class="stat-grid">
            <div class="stat-card">
                <div class="stat-label">Shares Held</div>
                <div class="stat-value">{{numberOfShares}}</div>
            </div>
            <div class="stat-card">
                <div class="stat-label">Avg Buy Price</div>
                <div class="stat-value">£{{buyPrice}}</div>
            </div>
            <div class="stat-card">
                <div class="stat-label">Current Price</div>
                <div class="stat-value">£{{lastPrice}}</div>
            </div>
            <div class="stat-card">
                <div class="stat-label">Current Value</div>
                <div class="stat-value">£{{currentCashAmount}}</div>
            </div>
        </div>

        <div class="stat-grid">
            <div class="stat-card">
                <div class="stat-label">Unrealised P&L</div>
                <div class="stat-value pnl-value">£{{pnl}} ({{pnlPercentage}}%)</div>
            </div>
            <div class="stat-card">
                <div class="stat-label">Realised P&L</div>
                <div class="stat-value pnl-value">£{{realisedPnl}}</div>
            </div>
        </div>

        <div class="stat-grid">
            <div class="stat-card full">
                <div class="stat-label">Total Invested</div>
                <div class="stat-value">£{{totalInvested}}</div>
            </div>
        </div>

    {{/with}}

</main>

<script>
    document.querySelectorAll('.pnl-value').forEach(el => {
        const val = parseFloat(el.textContent.replace('£', ''));
        el.classList.add(val >= 0 ? 'positive' : 'negative');
    });
</script>

</body>
</html>