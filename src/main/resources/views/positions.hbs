<!doctype html>
<html lang="en">

<head>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>Portfolio</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css">

    <link rel="stylesheet" href="/assets/styles.css">

    <style>

        .page-wrapper{
            max-width:900px;
            margin:auto;
            padding-top:20px;
        }

        .position-row{
            display:flex;
            justify-content:space-between;
            align-items:center;
            padding:16px;
            border-bottom:1px solid var(--border);
        }
        .position-header{
            display:flex;
            justify-content:space-between;
            align-items:center;
            padding:16px;
            border-bottom:1px solid var(--border);
        }

        .position-row:hover{
            background:#f8fbff;
            cursor:pointer;
        }

        .ticker{
            font-weight:700;
            font-size:18px;
        }

        .shares{
            color:#6c7b93;
            font-size:14px;
        }

        .value{
            font-weight:700;
        }
        .table-header{
            font-weight:700;
            font-size:18px;
        }

    </style>

</head>

<body>

{{>partials/navbar.hbs}}
<main class="page-wrapper">

    <h3 class="mb-4">Your Positions</h3>

    <div class="card-soft">
        <div class="position-header">
            <div class="table-header">Ticker</div>
            <div class="table-header">Shares</div>
            <div class="table-header">Value</div>
        </div>

        {{#if positions}}

            {{#each positions}}

                <a href="/analytics/{{ticker}}" style="text-decoration:none;color:inherit;">

                    <div class="position-row">


                        <div class="ticker"> {{ticker}}</div>
                        <div class="shares">{{shares}}</div>
                        <div class="value">£{{currentValue}}</div>

                    </div>

                </a>

            {{/each}}

        {{else}}

            <p class="text-muted">No investments yet</p>

        {{/if}}

    </div>

</main>

</body>
</html>
