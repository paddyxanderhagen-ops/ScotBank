<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <Title>Scotbank</Title>
        <link rel="stylesheet" href="/assets/styles.css">
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
        <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

        <style>

        .breakdown-container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 20px;
            font-family: Arial, sans-serif;
        }

        .breakdown-summary {
            display: flex;
            gap: 20px;
            margin-bottom: 20px;
        }

        .summary-card {
            padding: 15px;
            background: #f4f6f8;
            border-radius: 8px;
            flex: 1;
            text-align: center;
            font-size: 1.1em;
        }

        .tabs {
            display: flex;
            border-bottom: 2px solid #ddd;
            margin-bottom: 20px;
        }

        .tab-btn {
            padding: 10px 20px;
            background: none;
            border: none;
            cursor: pointer;
            font-size: 1em;
            font-weight: bold;
            color: #666;
        }

        .tab-btn.active {
            color: #0056b3;
            border-bottom: 3px solid #0056b3;
            margin-bottom: -2px;
        }

        .dashboard-content {
            display: flex;
            gap: 30px;
            align-items: flex-start;
        }

        .chart-container {
            flex: 1;
            min-width: 300px;
            max-width: 400px;
            position: relative;
        }

        .table-container {
            flex: 2;
            overflow-x: auto;
        }

        /* Table styling */
        .details-table {
            width: 100%;
            border-collapse: collapse;
        }

        .details-table th, .details-table td {
            padding: 12px;
            text-align: left;
            border-bottom: 1px solid #eee;
        }

        .details-table th {
            background-color: #f8f9fa;
            font-weight: 600;
        }

        /* Design for mobile */
        @media (max-width: 768px) {
            .dashboard-content {
                flex-direction: column;
            }

            .chart-container {
                max-width: 100%;
                margin: 0 auto;
            }

            .breakdown-summary {
                flex-direction: column;
            }
        }


        </style>
    </head>

    <body>
        {{>partials/navbar.hbs}}

        <div class="breakdown-container">
            <h2>Portfolio Breakdown</h2>
            <div class="breakdown-summary">
                <div class="summary-card">Invested Value: <strong id="investedValue">£0.00</strong></div>
                <div class="summary-card">Cash Balance: <strong id="cashBalance">£{{balance}}</strong></div>
                <div class="summary-card">Total Portfolio: <strong id="totalPortfolio">£0.00</strong></div>
            </div>

            <!-- Tabs -->
            <div class="tabs" id="categoryTabs">
                <button class="tab-btn active" data-tab="country">Country</button>
                <button class="tab-btn" data-tab="region">Geographic Exposure</button>
                <button class="tab-btn" data-tab="sector">Sector Breakdown</button>
            </div>

            <!-- Dashboard Content -->
            <div class="dashboard-content">
                <!-- Left: Pie Chart -->
                <div class="chart-container">
                    <canvas id="portfolioPieChart"></canvas>
                </div>

                <!-- Right: Details Table -->
                <div class="table-container">
                    <h3 id="tableTitle">All Equities</h3>
                    <table class="details-table">
                        <thead>
                        <tr>
                            <th>Ticker</th>
                            <th>Name</th>
                            <th>Shares</th>
                            <th>Value (£)</th>
                            <th>% of Category</th>
                            <th>% of Total</th>
                        </tr>
                        </thead>
                        <tbody id="equitiesTableBody">
                            <!-- done using JS -->
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <script src="/assets/portfolio-breakdown.js"></script>
    </body>
</html>