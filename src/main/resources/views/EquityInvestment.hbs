<!doctype html>
<html lang="en">

<head>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>Portfolio</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css">

    <link rel="stylesheet" href="/assets/styles.css">

    <style>

        .page-wrapper{
            max-width:900px;
            margin:auto;
            padding-top:20px;
        }

        .position-row{
            display:flex;
            justify-content:space-between;
            align-items:center;
            padding:16px;
            border-bottom:1px solid var(--border);
        }
        .position-header{
            display:flex;
            justify-content:space-between;
            align-items:center;
            padding:16px;
            border-bottom:1px solid var(--border);
        }

        .position-row:hover{
            background:#f8fbff;
            cursor:pointer;
        }

        .ticker{
            font-weight:700;
            font-size:18px;
        }

        .shares{
            color:#6c7b93;
            font-size:14px;
        }

        .value{
            font-weight:700;
        }
        .table-header{
            font-weight:700;
            font-size:18px;
        }
        .login-btn{
            background:var(--blue);
            border:none;
            border-radius:12px;
            padding:14px;
            font-weight:700;
            color:white;
        }
        .login-btn:hover{
            background:var(--blue-dark);
            color:(--blue-dark);
        }
        .button-wrapper{
            display:inline-block;
            padding:10px;
            max-width:400px;
            margin:auto;
        }
    </style>

</head>

<body>

{{>partials/navbar.hbs}}
<div class="button-wrapper">
<form class="login-card" action="/Investments" method="get">
<button
                type="submit"
                class="btn login-btn w-100">

            Return
  </button>

</div>
<main class="page-wrapper">

    <h3 class="mb-4">Information for investment {{ticker}}</h3>

    {{#with equity}}

    <p>name: {{name}}</p>
    <p>ticker: {{ticker}}</p>
    <p>sector: {{sector}}</p>
    <p>latest price: {{price}}</p>

    {{/with}}

</main>

</body>
</html>
